# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*

# Track handoff state (.agents/) and shared Claude Code config (.claude/) in git,
# even though the global gitignore ignores all dotfiles (".*"). Repo rules win.
# No trailing slash so the negation also applies before the dir exists on disk;
# the /** form re-includes nested dotfiles (e.g. .agents/.gitkeep) too.
!.agents
!.agents/**
!.claude
!.claude/**
!.github
!.github/**
# ...but personal local Claude Code settings stay out of git.
.claude/settings.local.json
# ...and transient scratch under .agents/ stays out of commits (canonical
# handoff files like plan/changes/review/test-report/summary.md are tracked;
# put throwaway work — diffs, A/B variants, run logs — in .agents/scratch/
# or give it an underscore prefix).
.agents/scratch/
.agents/_*

# Editor/IDE
# .idea/
.vscode/

tmp/

# Untracked local scratch directories
_knowledge-base/
_patterns/

# compiled sample-service binary (build artifact from the e2e pipeline target)
/examples/sample-service/sample-service

# dreaming reports/log are generated weekly — keep the script+prompt, not the output
.claude/dreaming/reports/

# fix-review runtime output (run logs, not skill config)
.claude/skills/fix-review/telemetry.jsonl
