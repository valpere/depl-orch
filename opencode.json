{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Pro cloud)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3-coder-next:cloud": { "tools": true },
        "devstral-small-2:24b-cloud": { "tools": true },
        "qwen3.5:cloud": { "tools": true },
        "minimax-m3:cloud": { "tools": true },
        "kimi-k2.6:cloud": { "tools": true }
      }
    }
  },

  "agent": {
    "coder": {
      "description": "Implements code changes per .agents/plan.md. Writes a changelog to .agents/changes.md.",
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:cloud",
      "temperature": 0.1,
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "reviewer": {
      "description": "Independent review: bugs, security, Go idioms. Read-only. Non-Claude family (reviews code Claude Code wrote).",
      "mode": "primary",
      "model": "ollama/minimax-m3:cloud",
      "temperature": 0.3,
      "tools": { "write": false, "edit": false, "bash": false }
    },
    "tester": {
      "description": "Runs go test, diagnoses failures, applies minimal fixes. Writes .agents/test-report.md.",
      "mode": "primary",
      "model": "ollama/devstral-small-2:24b-cloud",
      "temperature": 0.1,
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "documenter": {
      "description": "Writes/updates README, godoc comments, and .agents/summary.md.",
      "mode": "primary",
      "model": "ollama/qwen3.5:cloud",
      "temperature": 0.4,
      "tools": { "write": true, "edit": true, "bash": false }
    }
  }
}
