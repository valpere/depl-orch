{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "depl-orch pipeline observability: stage timing, retry rate, token usage, cost",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Stage Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (stage, le) (rate(depl_orch_stage_duration_seconds_bucket{status=\"ok\"}[$__rate_interval])))",
          "legendFormat": "p50 {{stage}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(depl_orch_stage_duration_seconds_bucket{status=\"ok\"}[$__rate_interval])))",
          "legendFormat": "p95 {{stage}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stage Retry Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (stage) (rate(depl_orch_stage_attempts_total{status=\"failed\"}[$__rate_interval]))",
          "legendFormat": "failures/s {{stage}}",
          "refId": "A"
        },
        {
          "expr": "sum by (stage) (rate(depl_orch_stage_attempts_total{status=\"ok\"}[$__rate_interval]))",
          "legendFormat": "success/s {{stage}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (step, token_type) (increase(depl_orch_agent_tokens_total[$__rate_interval]))",
          "legendFormat": "{{step}} {{token_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent Cost (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (step) (increase(depl_orch_agent_cost_usd_total[$__rate_interval]))",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["depl-orch", "pipeline", "observability"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "depl-orch Pipeline",
  "uid": "depl-orch-v1",
  "version": 1
}
